# shellcheck disable=SC2016,SC2034

# Environment variables for Git for Windows install of GnuPG on Windows.  May
# work for MSYS2 and CYGWIN installs as well.

# If you have a custom install location, change this to point to bash.exe of
# your install.
GPG_BRIDGE_GPGCONF_CMD='/mnt/c/Program Files/Git/bin/bash.exe'

# Flag to interpret the next argument as a list of commands
GPG_BRIDGE_GPGCONF_ARG1='-c'

# Converts the output of 'gpgconf --list-dirs agent-socket' from cygwin format
# to window format.
GPG_BRIDGE_GPGCONF_ARG2='
VALUE="$(gpgconf "$@")"
EXIT="$?"
if [ "$EXIT" -eq 0 ] && { [ "$1" = --list-dirs ] || [ "$1" = -L ]; } && [ -n "$2" ] && [ -n "$VALUE" ]; then
    cygpath -w "$VALUE"
    EXIT="$?"
else
    printf %s\\n "$VALUE"
fi
exit "$EXIT"
'

# Value of $0
GPG_BRIDGE_GPGCONF_ARG3='gpgconf'

# WSL way of exposing the environment variables from WSL to Win32
WSLENV="GPG_BRIDGE_GPGCONF_CMD/wp:GPG_BRIDGE_GPGCONF_ARG1/w:GPG_BRIDGE_GPGCONF_ARG2/w:GPG_BRIDGE_GPGCONF_ARG3/w"
