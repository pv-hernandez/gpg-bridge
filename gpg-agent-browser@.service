[Unit]
Description=Windows bridge for GPG Agent's browser socket
Requires=gpg-agent-broser.socket
CollectMode=inactive-or-failed

[Service]
# EnvironmentFile=%E/gpgagentbridge/git-for-windows.env
# EnvironmentFile=%E/gpgagentbridge/gnupg-standalone.env
# ExecSearchPath=
ExecStart=gpgagentbridge.exe agent-browser-socket
StandardInput=socket
StandardOutput=socket
StandardError=journal
