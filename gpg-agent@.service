[Unit]
Description=Windows bridge for GPG Agent
Requires=gpg-agent.socket
CollectMode=inactive-or-failed

[Service]
# EnvironmentFile=%E/gpg-bridge/git-for-windows.env
# EnvironmentFile=%E/gpg-bridge/gnupg-standalone.env
# ExecSearchPath=
ExecStart=gpg-bridge.exe agent-socket
StandardInput=socket
StandardOutput=socket
StandardError=journal
