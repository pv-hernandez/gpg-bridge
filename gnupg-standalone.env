# shellcheck disable=SC2034

# Environment variables for a standalone install of GnuPG on Windows.

# If you have a custom install location, change this to point to gpgconf.exe of
# your install.  If it is in windows PATH, you can use 'gpgconf' directly.
GPG_BRIDGE_GPGCONF_CMD='/mnt/c/Program Files/GnuPG/bin/gpgconf.exe'

# WSL way of exposing the environment variables from WSL to Win32
WSLENV="GPG_BRIDGE_GPGCONF_CMD/wp"
