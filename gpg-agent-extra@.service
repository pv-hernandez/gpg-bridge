[Unit]
Description=Windows bridge for GPG Agent' extra socket
Requires=gpg-agent-extra.socket
CollectMode=inactive-or-failed

[Service]
# EnvironmentFile=%E/gpg-bridge/git-for-windows.env
# EnvironmentFile=%E/gpg-bridge/gnupg-standalone.env
# ExecSearchPath=
ExecStart=gpg-bridge.exe agent-extra-socket
StandardInput=socket
StandardOutput=socket
StandardError=journal
